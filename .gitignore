# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large data files — never deploy or commit
Oasis-*
data/
scripts/.off-dump.jsonl.gz
scripts/.obf-dump.jsonl.gz
scripts/*.jsonl.gz
scripts/.deltas/
scripts/.*-checkpoint.json
scripts/.recategorize-snapshot-*.json
scripts/.recategorize-review-queue.json
supabase/.temp/
.env*.local
src/data/master-products.json

# capacitor (native shells generated by `npx cap add android|ios`)
/android
/ios
/dist

# e2e
/test-results
/playwright-report
/playwright/.cache
/.claude/
